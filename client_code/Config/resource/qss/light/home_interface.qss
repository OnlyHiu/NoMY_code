SettingInterface,
#view {
    background-color: transparent;
}

QScrollArea {
    border: none;
    background-color: transparent;
}


BannerWidget > #galleryLabel {
    font: 42px 'Segoe UI SemiBold', 'Microsoft YaHei SemiBold';
    background-color: transparent;
    color: black;
    padding-left: 28px;
}
#cardScrollWidget {
    background-color: transparent;
}

QScrollArea#cardScrollArea {
    border: none;
    background-color: transparent;
}

#cardToolBar {
    background-color: transparent;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
}

