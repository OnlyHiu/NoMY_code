SettingInterface, #scrollWidget {
    background-color: rgb(39, 39, 39);
}

QScrollArea {
    border: none;
    background-color: transparent;
}
QTableWidget::item:selected {
    background-color: #98F5FF;  /* 选中背景色 */
}
QTableWidget::item:disabled:selected {
    background-color: transparent;  /* 不应用选中背景色 */
}

/* 标签 */
QLabel#settingLabel {
    font: 33px 'Microsoft YaHei Light';
    background-color: transparent;
    color: white;
}


